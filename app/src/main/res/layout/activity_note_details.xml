<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary"
    tools:context=".ui.activity.NoteDetailsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_note_details_toolbar"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="?attr/colorOnPrimaryContainer"
        app:subtitleTextColor="?attr/colorOnPrimaryContainer"
        android:background="?attr/colorPrimaryContainer"
        tools:subtitle="01.01.2026"
        tools:title="Create note" />

    <ImageButton
        android:id="@+id/button_copy_note_text"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/copy"
        android:src="@drawable/ic_copy"
        app:tint="?attr/colorOnSecondary"
        app:layout_constraintBottom_toBottomOf="@id/spinner_note_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner_note_category" />

    <ImageButton
        android:id="@+id/button_share"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:layout_marginEnd="10dp"
        app:tint="?attr/colorOnSecondary"
        android:src="@drawable/ic_share"
        app:layout_constraintBottom_toBottomOf="@id/spinner_note_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spinner_note_category" />

    <Spinner
        android:background="@drawable/background_edit_note_text"
        android:padding="5dp"
        android:id="@+id/spinner_note_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toStartOf="@+id/button_share"
        app:layout_constraintStart_toEndOf="@+id/button_copy_note_text"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <EditText
        android:background="@drawable/background_edit_note_text"
        android:padding="5dp"
        android:id="@+id/edit_note_text"
        android:textColor="?attr/colorOnPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:hint="@string/enter_note_text"
        app:layout_constraintTop_toBottomOf="@+id/spinner_note_category" />

</androidx.constraintlayout.widget.ConstraintLayout>